# ===== oppflow 环境配置 =====
# 复制为 .env 后按需修改；凭据只从这里读，切勿提交 .env

# --- 安全 ---
SECRET_KEY=change-me-to-a-random-string
ACCESS_TOKEN_MINUTES=1440
REFRESH_TOKEN_DAYS=30

# --- 业务开关 ---
# 是否开启邀请码注册（冷启动策略，建议 true）
INVITE_REQUIRED=true
# 机会发布是否需要管理员审核
REVIEW_REQUIRED=true
# 这些邮箱注册即管理员（首位注册用户自动成为管理员）
ADMIN_EMAILS=

# --- 基础设施 ---
DATABASE_URL=sqlite:///./data/oppflow.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# 对外可见的站点地址（分享页 CTA、OAuth 回跳使用）
APP_PUBLIC_BASE_URL=http://localhost:5173
# 生产环境指向前端构建产物目录（容器内 /app/frontend/dist）
FRONTEND_DIST_DIR=

# --- GitHub OAuth（可选，未配置时验证功能返回 501）---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# 默认 {APP_PUBLIC_BASE_URL}/api/auth/github/callback，反向代理场景显式指定
GITHUB_REDIRECT_URI=

# --- AI 渠道（OpenAI 兼容，可多个，priority 小者优先）---
# 示例：[{"name":"main","base_url":"https://api.openai.com/v1","api_key":"sk-...","model":"gpt-4o-mini","priority":10}]
AI_CHANNELS_JSON=

# --- 后台任务 ---
SCHEDULER_ENABLED=true
